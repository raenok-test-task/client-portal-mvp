generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  phone        String?
  company      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  orders        Order[]
  supportTickets SupportTicket[]

  @@map("users")
}

model Order {
  id        String      @id @default(uuid())
  number    String      @unique
  date      DateTime
  status    OrderStatus @default(PENDING)
  amount    Decimal     @db.Decimal(12, 2)
  currency  String      @default("USD")
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model SupportTicket {
  id        String       @id @default(uuid())
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@map("support_tickets")
}
