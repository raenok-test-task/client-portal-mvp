# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal?schema=public"

# JWT signing secret (use a long random value in production)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

# Backend HTTP port
PORT=3000

# CORS origin for the frontend
FRONTEND_ORIGIN="http://localhost:5173"

# --- AI assistant ---
# Provider: "openai" or "mock" (mock = deterministic rule-based, no key required)
AI_PROVIDER="mock"
# Only needed when AI_PROVIDER=openai
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
